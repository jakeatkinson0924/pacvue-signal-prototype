# Copy this file to .env and fill in your key. Never commit .env.

# Needed for web search. Create one at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# AI model settings (defaults shown). To switch to OpenAI later:
# LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=<model>, LLM_API_KEY=<your OpenAI key>
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:cloud
